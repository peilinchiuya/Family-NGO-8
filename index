            days.forEach(day => {
                const items = state.itinerary[day.id] || [];
                if (items.length > 0) {
                    html += `<div class="mb-12 avoid-break"><div class="inline-block bg-gradient-to-r from-[#FFEFF4] to-white border border-pink-100 rounded-full px-5 py-1.5 mb-6 shadow-sm"><span class="text-[#DB2777] font-black text-sm tracking-widest uppercase">DAY ${day.id.replace('day','')} - ${day.date} ${day.name}</span></div><div class="space-y-8 pl-2">`;
                    items.forEach(item => {
                        html += `
                            <div class="flex gap-4">
                                <div class="w-24 shrink-0 text-[#FF6B9E] font-black text-[13px] pt-1">${escapeHTML(item.time)}</div>
                                <div class="flex-1 pb-6 ${items.indexOf(item) !== items.length -1 ? 'border-b border-gray-100' : ''}">
                                    <div class="flex items-center gap-2 mb-1"><h4 class="text-lg font-black text-gray-800">${escapeHTML(item.location)}</h4></div>
                                    ${item.detail ? `<p class="text-xs font-bold text-blue-500 mb-2 flex items-center gap-1"><i data-lucide="ticket" class="w-3 h-3"></i> ${escapeHTML(item.detail)}</p>` : ''}
                                    ${item.notes ? `<p class="text-[13px] font-bold text-gray-500 leading-relaxed whitespace-pre-line mb-3">${escapeHTML(item.notes)}</p>` : ''}
                                    ${item.image ? `<img src="${item.image}" class="w-full max-w-[400px] rounded-2xl object-cover shadow-sm border border-gray-100 mt-2" />` : ''}
                                </div>
                            </div>
                        `;
                    });
                    html += `</div></div>`;
                }
            });
            html += `</div><div class="px-8 md:px-16 py-12 page-break"><h2 class="text-2xl font-black text-[#DB2777] mb-8 text-center flex items-center justify-center gap-2 border-b border-pink-100 pb-4"><i data-lucide="book-open" class="w-6 h-6"></i> 交換日記</h2><div class="space-y-4">`;
            if (state.diaries.length > 0) {
                 state.diaries.slice().reverse().forEach(d => { const p = userProfiles[d.owner] || userProfiles['guest']; html += `<div class="bg-[#FFF0F5]/50 p-5 rounded-2xl border border-pink-50 avoid-break"><div class="flex justify-between items-center mb-3"><div class="flex items-center gap-2"><span class="text-xl">${d.mood}</span><span class="font-black text-[#DB2777] text-sm">${p.name}</span></div><span class="text-[10px] text-gray-400 font-bold">${d.date}</span></div><p class="text-gray-700 font-bold text-[14px] leading-relaxed">${escapeHTML(d.text)}</p></div>`; });
            } else { html += `<p class="text-gray-400 text-sm font-bold text-center">還沒有日記喔！</p>`; }
            html += `</div></div><div class="px-8 md:px-16 py-12 page-break"><h2 class="text-2xl font-black text-[#DB2777] mb-8 text-center flex items-center justify-center gap-2 border-b border-pink-100 pb-4"><i data-lucide="camera" class="w-6 h-6"></i> 拍立得回憶</h2><div class="grid grid-cols-2 gap-6">`;
            if (state.memories.length > 0) {
                state.memories.forEach(mem => { const p = userProfiles[mem.addedBy] || userProfiles['guest']; html += `<div class="bg-white p-3 rounded-2xl border border-gray-100 shadow-sm avoid-break flex flex-col"><img src="${mem.image}" class="w-full aspect-[4/3] object-cover rounded-xl mb-3" /><p class="text-[13px] font-black text-center text-gray-700 mb-1 flex-1 flex items-center justify-center">${escapeHTML(mem.caption)}</p><p class="text-[9px] text-gray-400 text-center font-bold mt-2">${mem.date} · ${p.name}</p></div>`; });
            } else { html += `<div class="col-span-2 text-center text-gray-400 text-sm font-bold">還沒有照片喔！</div>`; }
            html += `</div><div class="text-center mt-20 pb-10"><p class="text-[#FFB6C1] font-black text-xl tracking-widest italic">The End</p></div></div></div>`;
            container.innerHTML = html; app.classList.add('hidden'); container.classList.remove('hidden'); if (window.lucide) window.lucide.createIcons(); window.scrollTo(0,0);
        };

        window.closeBookletPreview = () => { document.getElementById('booklet-preview-container').classList.add('hidden'); document.getElementById('booklet-preview-container').innerHTML = ''; document.getElementById('app-container').classList.remove('hidden'); };
        window.printBooklet = () => { setTimeout(() => { window.print(); }, 300); };
        window.openImageViewer = (src) => { state.imageViewer = { isOpen: true, src: src }; window.renderDOM(); };
        window.closeImageViewer = () => { state.imageViewer.isOpen = false; window.renderDOM(); };
        window.triggerItineraryPhoto = (dayId, idx) => { state.uploadingItineraryPhoto = { dayId, idx }; document.getElementById('itinerary-photo-upload').click(); };

        window.handleItineraryPhotoUpload = (e) => {
            const file = e.target.files[0]; const { dayId, idx } = state.uploadingItineraryPhoto;
            if (!file || !dayId) return;
            const reader = new FileReader();
            reader.onload = (event) => {
                const img = new Image();
                img.onload = () => {
                    const canvas = document.createElement('canvas'); let w = img.width, h = img.height;
                    if (w > h) { if (w > 800) { h *= 800 / w; w = 800; } } else { if (h > 800) { w *= 800 / h; h = 800; } }
                    canvas.width = w; canvas.height = h; canvas.getContext('2d').drawImage(img, 0, 0, w, h);
                    state.itinerary[dayId][idx].image = canvas.toDataURL('image/jpeg', 0.7); window.saveToCloud(); window.showToast('照片上傳成功！呀哈！');
                };
                img.src = event.target.result;
            };
            reader.readAsDataURL(file); e.target.value = ''; state.uploadingItineraryPhoto = { dayId: null, idx: null };
        };

        window.deleteItineraryPhoto = (dayId, idx) => { delete state.itinerary[dayId][idx].image; window.saveToCloud(); };
        window.openShoppingModal = () => { state.shoppingModal = { isOpen: true, isEdit: false, id: null, name: '', price: '', image: null }; window.renderDOM(); };
        window.editShoppingItem = (id) => { const item = state.shoppingList.find(i => String(i.id) === String(id)); if(item) { state.shoppingModal = { isOpen: true, isEdit: true, id: item.id, name: item.name, price: item.price || '', image: item.image || null }; window.renderDOM(); } };
        window.closeShoppingModal = () => { state.shoppingModal.isOpen = false; window.renderDOM(); };
        window.updateShoppingForm = (key, val) => { state.shoppingModal[key] = val; };
        
        window.handleShoppingPhotoUpload = (e) => {
            const file = e.target.files[0]; if (!file) return;
            const reader = new FileReader();
            reader.onload = (event) => {
                const img = new Image();
                img.onload = () => {
                    const canvas = document.createElement('canvas'); let w = img.width, h = img.height;
                    if (w > h) { if (w > 300) { h *= 300 / w; w = 300; } } else { if (h > 300) { w *= 300 / h; h = 300; } }
                    canvas.width = w; canvas.height = h; canvas.getContext('2d').drawImage(img, 0, 0, w, h);
                    state.shoppingModal.image = canvas.toDataURL('image/jpeg', 0.6); window.renderDOM();
                };
                img.src = event.target.result;
            };
            reader.readAsDataURL(file); e.target.value = '';
        };

        window.saveShoppingItem = () => {
            if (!state.shoppingModal.name.trim()) { window.showToast('要記得填寫物品名稱喔！🛍️'); return; }
            if (state.shoppingModal.isEdit) { state.shoppingList = state.shoppingList.map(item => String(item.id) === String(state.shoppingModal.id) ? { ...item, name: state.shoppingModal.name.trim(), price: state.shoppingModal.price, image: state.shoppingModal.image } : item); } 
            else { state.shoppingList.push({ id: Date.now(), name: state.shoppingModal.name.trim(), price: state.shoppingModal.price, image: state.shoppingModal.image, checked: false }); }
            state.shoppingModal.isOpen = false; window.saveToCloud();
        };

        window.toggleShoppingItem = (id) => { state.shoppingList = state.shoppingList.map(i => String(i.id) === String(id) ? { ...i, checked: !i.checked } : i); window.saveToCloud(); };
        window.deleteShoppingItem = (id) => { state.shoppingList = state.shoppingList.filter(item => String(item.id) !== String(id)); window.saveToCloud(); };
        window.switchMemoryMode = (mode) => { state.activeMemoryMode = mode; window.renderDOM(); };
        window.setDiaryMood = (mood) => { state.diaryMood = mood; window.renderDOM(); };
        window.addDiary = () => { const input = document.getElementById('new-diary-input'); const text = input.value.trim(); if (!text) { window.showToast('要打些字才能寫日記喔！呀哈！'); return; } state.diaries.push({ id: Date.now(), text: text, mood: state.diaryMood, date: new Date().toLocaleString('zh-TW', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }), owner: state.currentUser || 'peilin' }); window.saveToCloud(); };
        window.deleteDiary = (id) => { state.diaries = state.diaries.filter(d => String(d.id) !== String(id)); window.saveToCloud(); };
        window.switchListMode = (mode) => { state.activeListMode = mode; window.renderDOM(); };
        window.setWishCategory = (cat) => { state.wishCategory = cat; window.renderDOM(); };
        window.addWish = () => { const input = document.getElementById('new-wish-item'); const text = input.value.trim(); if (!text) return; state.wishes.push({ id: Date.now(), text: text, type: state.wishCategory, checked: false, addedBy: state.currentUser || 'guest' }); window.saveToCloud(); };
        window.toggleWish = (id) => { state.wishes = state.wishes.map(i => String(i.id) === String(id) ? { ...i, checked: !i.checked } : i); window.saveToCloud(); };
        window.editWish = (id) => { const item = state.wishes.find(i => String(i.id) === String(id)); if (item) { const newText = prompt('修改你的願望：', item.text); if (newText !== null && newText.trim() !== '') { state.wishes = state.wishes.map(i => String(i.id) === String(id) ? { ...i, text: newText.trim() } : i); window.saveToCloud(); } } };
        window.deleteWish = (id) => { state.wishes = state.wishes.filter(item => String(item.id) !== String(id)); window.saveToCloud(); };
        window.openExpenseModal = () => { state.expenseModal = { isOpen: true, description: '', amount: '', currency: 'JPY' }; window.renderDOM(); };
        window.closeExpenseModal = () => { state.expenseModal.isOpen = false; window.renderDOM(); };
        window.updateExpenseForm = (f, v) => { state.expenseModal[f] = v; if(f==='currency') window.renderDOM(); };
        window.saveExpense = () => { if (!state.expenseModal.description.trim() || !state.expenseModal.amount) { window.showToast('請輸入花費項目和金額喔！呀哈！'); return; } state.expenses.push({ id: Date.now(), date: new Date().toLocaleDateString('zh-TW', { month: 'short', day: 'numeric' }), description: state.expenseModal.description.trim(), amount: parseFloat(state.expenseModal.amount), currency: state.expenseModal.currency || 'JPY', owner: state.currentUser }); state.expenseModal.isOpen = false; window.saveToCloud(); };
        window.deleteExpense = (id) => { state.expenses = state.expenses.filter(e => String(e.id) !== String(id)); window.saveToCloud(); };
        window.showUserSelectModal = () => { state.showUserSelect = true; window.renderDOM(); };
        window.selectUser = (userId) => { state.currentUser = userId; state.showUserSelect = false; state.activeChecklistTab = userId === 'guest' ? 'all' : userId; window.renderDOM(); };
        window.switchChecklistTab = (tabId) => { state.activeChecklistTab = tabId; window.renderDOM(); };
        window.triggerPhotoUpload = () => { document.getElementById('photo-upload').click(); };
        
        window.handlePhotoUpload = (e) => {
            const file = e.target.files[0]; if (!file) return; const reader = new FileReader();
            reader.onload = (event) => {
                const img = new Image();
                img.onload = () => {
                    const canvas = document.createElement('canvas'); let w = img.width, h = img.height;
                    if (w > h) { if (w > 400) { h *= 400 / w; w = 400; } } else { if (h > 400) { w *= 400 / h; h = 400; } }
                    canvas.width = w; canvas.height = h; canvas.getContext('2d').drawImage(img, 0, 0, w, h);
                    const base64 = canvas.toDataURL('image/jpeg', 0.6);
                    setTimeout(() => { const caption = prompt('為這張相片寫下一句回憶吧！呀哈！'); if (caption !== null) { state.memories.unshift({ id: Date.now(), image: base64, caption: caption || '美好的一天', date: new Date().toLocaleDateString('zh-TW', { month: 'short', day: 'numeric' }), addedBy: state.currentUser }); window.saveToCloud(); } }, 100);
                };
                img.src = event.target.result;
            };
            reader.readAsDataURL(file); e.target.value = '';
        };

        window.deleteMemory = (id) => { state.memories = state.memories.filter(m => String(m.id) !== String(id)); window.saveToCloud(); };
        window.drawFortune = () => { if (state.isFortuneDrawing) return; state.isFortuneDrawing = true; window.renderDOM(); const f = ["🌟 大吉！今天扭蛋一發入魂！", "🍱 中吉！會吃到超美味隱藏美食！", "🛍️ 小吉！買到最後一個限量伴手禮！", "📸 吉！今天天氣超好怎麼拍都好看！", "♨️ 大吉！泡溫泉通體舒暢疲勞全消！", "💰 吉！匯率剛好很划算感覺賺到了！"]; setTimeout(() => { state.fortuneResult = f[Math.floor(Math.random() * f.length)]; state.isFortuneDrawing = false; window.renderDOM(); }, 1200); };
        window.switchTab = (tabId) => { state.activeTab = tabId; state.isTabSwitch = true; window.scrollTo({top: 0, behavior: 'smooth'}); window.renderDOM(); };
        window.switchDay = (dayId) => { state.activeDay = dayId; state.activeAI = null; state.copyItinerarySuccess = false; state.needsScrollCenter = true; window.scrollTo({top: 0, behavior: 'smooth'}); window.renderDOM(); };
        
        window.toggleAI = (idx) => {
            const box = document.getElementById(`ai-box-${idx}`); const btn = document.getElementById(`ai-btn-${idx}`); if (!box || !btn) return;
            if (box.classList.contains('hidden')) { box.classList.remove('hidden'); box.classList.add('block'); btn.className = "flex items-center gap-1.5 px-3.5 py-2 rounded-full font-black active:scale-95 border shadow-sm bg-[#FF82AB] text-white border-[#FF82AB] transition-colors"; } 
            else { box.classList.add('hidden'); box.classList.remove('block'); btn.className = "flex items-center gap-1.5 px-3.5 py-2 rounded-full font-black active:scale-95 border shadow-sm border-white bg-white text-[#FF6B9E] transition-colors"; }
        };

        window.openGoogleMapsRoute = () => { const i = state.itinerary[state.activeDay] || []; if(i.length) window.open(`https://www.google.com/maps/dir/${i.map(item => encodeURIComponent(item.location)).join('/')}`, '_blank'); };
        window.openGoogleMaps = (dayId, idx) => { window.open(`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(state.itinerary[dayId][idx].location)}`, '_blank', 'noopener,noreferrer'); };
        
        window.copyTodayItinerary = () => {
            const dayInfo = days.find(d => d.id === state.activeDay); const items = state.itinerary[state.activeDay] || []; if(!items.length) return;
            let text = `📅 2026.${dayInfo.date} (${dayInfo.name}之旅)\n\n`; items.forEach(i => { text += `📍 ${i.time} | ${i.location}\n` + (i.detail?`   🎟️ ${i.detail}\n`:'') + (i.notes?`   📝 ${i.notes}\n`:'') + `\n`; });
            if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(text); else { const t = document.createElement("textarea"); t.value = text; t.style.position="fixed"; t.style.left="-999999px"; document.body.appendChild(t); t.focus(); t.select(); try { document.execCommand('copy'); } catch (err) {} t.remove(); }
            state.copyItinerarySuccess = true; window.renderDOM(); setTimeout(() => { state.copyItinerarySuccess = false; window.renderDOM(); }, 3000);
        };

        window.playGacha = () => {
            if (state.gachaAnimating) return; state.gachaAnimating = true; window.renderDOM();
            const opts = ['拉麵 🍜', '燒肉 🥩', '迴轉壽司 🍣', '居酒屋 🍢', '便利商店大餐 🍙', '漢堡排 🍛', '豬排飯 🍱', '烏龍麵 🍲', '文字燒 🥘', '速食漢堡 🍔', '海鮮丼 🐟']; let ticks = 0;
            const int = setInterval(() => {
                state.gachaResult = opts[Math.floor(Math.random() * opts.length)]; window.renderDOM(); ticks++;
                if(ticks > 15) { clearInterval(int); state.gachaAnimating = false; state.gachaResult = `🐰 兔兔說：吃【${state.gachaResult}】！烏拉！！`; window.renderDOM(); }
            }, 100);
        };

        window.toggleCheck = (id) => { state.checklist = state.checklist.map(i => String(i.id) === String(id) ? { ...i, checked: !i.checked } : i); window.saveToCloud(); };
        window.addChecklistItem = () => { const input = document.getElementById('new-checklist-item'); if (!input.value.trim()) return; state.checklist.push({ id: Date.now(), text: input.value.trim(), checked: false, assignee: state.activeChecklistTab }); input.value = ''; window.saveToCloud(); };
        window.editChecklistItem = (id) => { const item = state.checklist.find(i => String(i.id) === String(id)); if (item) { const newText = prompt('修改行李項目：', item.text); if (newText !== null && newText.trim() !== '') { state.checklist = state.checklist.map(i => String(i.id) === String(id) ? { ...i, text: newText.trim() } : i); window.saveToCloud(); } } };
        window.deleteChecklistItem = (id) => { state.checklist = state.checklist.filter(i => String(i.id) !== String(id)); window.saveToCloud(); };
        window.toggleRateEdit = (isEditing) => { state.isEditingRate = isEditing; window.renderDOM(); };
        window.updateRateValue = (val) => { state.exchangeRate = parseFloat(val) || 0.215; state.isEditingRate = false; window.saveToCloud(); };
        window.updateJpy = (val) => { state.jpyInput = val; window.renderDOM(); };
        window.handleJpyInput = (val) => { state.jpyInput = val; const el = document.getElementById('twd-result-text'); if(el) el.innerText = `NT$ ${Math.round(val * state.exchangeRate).toLocaleString()}`; };
        window.copyToClipboard = () => { const twd = Math.round(state.jpyInput * state.exchangeRate).toString(); if (navigator.clipboard && window.isSecureContext) navigator.clipboard.writeText(twd); else { const t = document.createElement("textarea"); t.value = twd; t.style.position="fixed"; t.style.left="-999999px"; document.body.appendChild(t); t.focus(); t.select(); try { document.execCommand('copy'); } catch (err) {} t.remove(); } state.copied = true; window.renderDOM(); setTimeout(() => { state.copied = false; window.renderDOM(); }, 2000); };
        window.openAddModal = () => { state.formData = { type: 'spot', time: '10:00-12:00', location: '', notes: '', detail: '', highlights: '' }; state.modalConfig = { isOpen: true, isEdit: false, dayId: state.activeDay, index: null }; window.renderDOM(); };
        window.openEditModal = (dayId, idx) => { state.formData = { ...state.itinerary[dayId][idx] }; state.modalConfig = { isOpen: true, isEdit: true, dayId: dayId, index: idx }; window.renderDOM(); };
        window.closeModal = () => { state.modalConfig.isOpen = false; window.renderDOM(); };
        window.updateFormType = (type) => { state.formData.type = type; window.renderDOM(); };
        window.updateFormData = (key, value) => { state.formData[key] = value; };
        
        window.saveItinerary = () => {
            if (!state.formData.location.trim()) { window.showToast('請輸入地點！呀哈！'); return; }
            state.formData.addedBy = state.currentUser || 'peilin';
            const dayList = [...(state.itinerary[state.modalConfig.dayId] || [])];
            if (state.modalConfig.isEdit) dayList[state.modalConfig.index] = state.formData; else dayList.push(state.formData);
            dayList.sort((a, b) => (a.time || '').localeCompare(b.time || ''));
            state.itinerary[state.modalConfig.dayId] = dayList;
            state.modalConfig.isOpen = false; window.saveToCloud(); 
        };

        window.confirmDelete = (dayId, idx) => { state.deleteConfirm = { isOpen: true, dayId: dayId, index: idx, location: state.itinerary[dayId][idx].location }; window.renderDOM(); };
        window.closeDeleteModal = () => { state.deleteConfirm.isOpen = false; window.renderDOM(); };
        window.executeDelete = () => { const dayList = [...(state.itinerary[state.deleteConfirm.dayId] || [])]; dayList.splice(state.deleteConfirm.index, 1); state.itinerary[state.deleteConfirm.dayId] = dayList; state.deleteConfirm = { isOpen: false, dayId: '', index: null, location: '' }; window.saveToCloud(); };

        window.renderDOM();
    </script>
